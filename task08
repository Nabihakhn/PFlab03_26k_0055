#include<stdio.h>
/*Write a C program that takes two integers as input and displays the quotient and remainder when the
first is divided by the second.*/

int main ()
{	
	int num1;
	int num2;
	int remainder;
	int quotient;
    printf("Enter num1: ");
    scanf("%u", &num1);
    printf("Enter num2: ");
    scanf("%u", &num2);
    remainder = num1%num2;
    quotient = num1/num2;
    printf("remainder: %u\n", remainder);
    printf("quotient: %u\n", quotient); 
}

